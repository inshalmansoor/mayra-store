# =============================================================================
#  Mayra Store — environment template.  SAFE TO COMMIT.
#  Copy to `.env` and fill in real values. Never commit the filled-in `.env`.
#  Every key below is required unless marked optional.
# =============================================================================

# --- 1. App ------------------------------------------------------------------
APP_ENV=development
ALLOWED_ORIGINS=http://localhost:3000

# --- 2. Database: Supabase Postgres ------------------------------------------
# Use the TRANSACTION POOLER (port 6543), prefix rewritten for psycopg 3.
DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=            # backend only — never expose to the browser
SUPABASE_STORAGE_BUCKET=product-images

# --- 3. Admin panel ----------------------------------------------------------
ADMIN_PASSWORD=
ADMIN_JWT_SECRET=                     # python -c "import secrets;print(secrets.token_urlsafe(48))"
ADMIN_SESSION_HOURS=8

# --- 4. Email: Brevo ---------------------------------------------------------
BREVO_API_KEY=
MAIL_FROM_EMAIL=                      # must be a VERIFIED sender in Brevo
MAIL_FROM_NAME=Mayra Store
OWNER_EMAIL=                          # owner gets a copy of every order
OWNER_NAME=Mayra

# --- 5. Store rules ----------------------------------------------------------
STORE_NAME=Mayra Store
STORE_CURRENCY=PKR
WHATSAPP_NUMBER=923113136446
INSTAGRAM_URL=https://www.instagram.com/mayra_.jewels/
# Delivery fee/threshold live in the admin-editable shipping_rates table
# (see /admin/shipping) — plans/09 §15-17. Not an env var.
LOW_STOCK_AT=3
DISCOUNT_CODE=MAYRA20
DISCOUNT_PERCENT=20

# --- 6. Bank transfer --------------------------------------------------------
BANK_NAME=
BANK_ACCOUNT_TITLE=
BANK_ACCOUNT_NUMBER=
BANK_IBAN=

# --- 7. Frontend (public — compiled into the JS bundle) ----------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_WHATSAPP_NUMBER=923113136446
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/mayra_.jewels/
NEXT_PUBLIC_STORE_NAME=Mayra Store
