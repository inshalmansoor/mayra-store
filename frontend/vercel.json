{
  "functions": {
    "api/index.py": { "memory": 1024, "maxDuration": 60 }
  },
  "crons": [
    { "path": "/api/health", "schedule": "0 6 * * *" }
  ],
  "headers": [
    {
      "source": "/admin/:path*",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    }
  ]
}
